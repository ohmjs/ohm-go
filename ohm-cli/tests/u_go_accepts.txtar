-- rules.go_accepts --
// Code generated by ohm-cli generate accepts - DO NOT EDIT.
package g

import (
	"github.com/ohmjs/ohm-go/ohm"
)

var GrammarMetada map[string]string = map[string]string{
	"sha256": "",
}

// accepts for grammar G
// TODO for grammar G, implement Make func for starting rule S
func MakeNodeFromRoot[P, R any](root goohm.Node) goohm.Acceptor[P, R] {
	kids := root.Children()
	return &S[P, R]{
		A: kids[0].(goohm.RuleNode),
	}
}

// Accept implementation for S
//
// S = A
func (node *S[P, R]) Accept(this goohm.Node, visitor any, payload P) (result R, err error) {
	goohm.AssertName(this, "S")
	if v, ok := visitor.(Visitor_S[P, R]); ok {
		v.VisitS(node)
		return
	}
	if v, ok := visitor.(VisitorE_S[P, R]); ok {
		err = v.VisitS(node)
		return
	}
	if v, ok := visitor.(VisitorP_S[P, R]); ok {
		v.VisitS(node, payload)
		return
	}
	if v, ok := visitor.(VisitorPE_S[P, R]); ok {
		err = v.VisitS(node, payload)
		return
	}
	if v, ok := visitor.(VisitorR_S[P, R]); ok {
		result = v.VisitS(node)
		return
	}
	if v, ok := visitor.(VisitorRE_S[P, R]); ok {
		result, err = v.VisitS(node)
		return
	}
	if v, ok := visitor.(VisitorPR_S[P, R]); ok {
		result = v.VisitS(node, payload)
		return
	}
	if v, ok := visitor.(VisitorPRE_S[P, R]); ok {
		result, err = v.VisitS(node, payload)
		return
	}
	goohm.TypeCheckMethod[P, R](visitor, "S")
	return node.DefaultAccept(visitor, payload)
}

func (node *S[P, R]) DefaultAccept(visitor any, payload P) (result R, err error) {
	result, err = node.AcceptA(visitor, payload)
	return
}

func (node *S[P, R]) AcceptA(visitor any, payload P) (result R, err error) {
	// Rule
	kids := node.A.Children()
	result, err = (&A[P, R]{
		Term: kids[0].(goohm.TerminalNode),
	}).Accept(node.A, visitor, payload)
	return
}

// Accept implementation for A
//
// A = "a"
func (node *A[P, R]) Accept(this goohm.Node, visitor any, payload P) (result R, err error) {
	goohm.AssertName(this, "A")
	if v, ok := visitor.(Visitor_A[P, R]); ok {
		v.VisitA(node)
		return
	}
	if v, ok := visitor.(VisitorE_A[P, R]); ok {
		err = v.VisitA(node)
		return
	}
	if v, ok := visitor.(VisitorP_A[P, R]); ok {
		v.VisitA(node, payload)
		return
	}
	if v, ok := visitor.(VisitorPE_A[P, R]); ok {
		err = v.VisitA(node, payload)
		return
	}
	if v, ok := visitor.(VisitorR_A[P, R]); ok {
		result = v.VisitA(node)
		return
	}
	if v, ok := visitor.(VisitorRE_A[P, R]); ok {
		result, err = v.VisitA(node)
		return
	}
	if v, ok := visitor.(VisitorPR_A[P, R]); ok {
		result = v.VisitA(node, payload)
		return
	}
	if v, ok := visitor.(VisitorPRE_A[P, R]); ok {
		result, err = v.VisitA(node, payload)
		return
	}
	goohm.TypeCheckMethod[P, R](visitor, "A")
	return node.DefaultAccept(visitor, payload)
}

func (node *A[P, R]) DefaultAccept(visitor any, payload P) (result R, err error) {
	result, err = node.AcceptTerm(visitor, payload)
	return
}

func (node *A[P, R]) AcceptTerm(visitor any, payload P) (result R, err error) {
	// Term
	if v, ok := visitor.(goohm.TerminalVisitor); ok {
		v.Terminal(node.Term)
	}
	return
}
