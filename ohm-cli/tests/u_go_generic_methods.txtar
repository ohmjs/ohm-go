}

func (node *S) DefaultAccept[P, R any](visitor any, payload P) (result R, err error) {
	result, err = node.AcceptA[P, R](visitor, payload)
	return
}

func (node *S) AcceptA[P, R any](visitor any, payload P) (result R, err error) {
	// Rule
	kids := node.A.Children()
	result, err = (&A{
		Term: kids[0].(ohm.TerminalNode),
